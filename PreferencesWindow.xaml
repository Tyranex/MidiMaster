<Window x:Class="SS14_MIDI_IDE.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preferences"
        Icon="mothroach.ico"
        Height="600" Width="800"
        Background="#1e1e1e"
        Foreground="White"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True">
    <Window.Resources>
        <!-- Dark Theme for TabItems -->
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" BorderThickness="1,1,1,1" BorderBrush="#3e3e42" Margin="2,2,0,2" Padding="15,10" Background="#3e3e42">
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#252526" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#3e3e42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Window.Resources>
    
    <Border CornerRadius="5" Background="#2d2d30" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Header -->
            <DockPanel Grid.Row="0" Height="30" Background="#3e3e42" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="Preferences" Foreground="White" VerticalAlignment="Center" Margin="10,0" FontWeight="Bold"/>
                <Button Width="30" Height="30" HorizontalAlignment="Right" Margin="0,0,5,0" Click="CloseButton_Click" Foreground="White">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Name="border" Background="Transparent" CornerRadius="3">
                                <Path Name="icon" Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="#999" StrokeThickness="2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#e81123"/>
                                    <Setter TargetName="icon" Property="Stroke" Value="White"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </DockPanel>
            <!-- Tabs -->
            <TabControl Grid.Row="1" TabStripPlacement="Left" Background="#2d2d30" BorderBrush="#3e3e42" Foreground="White">
                <TabItem Header="General">
                    <StackPanel Margin="10">
                        <TextBlock Text="Default Note Velocity (0-127):" Foreground="White" Margin="0,0,0,5"/>
                        <TextBox x:Name="DefaultVelocityTextBox" Width="100" HorizontalAlignment="Left" Background="#1e1e1e" Foreground="White" BorderBrush="#3e3e42"/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Audio">
                    <StackPanel Margin="10">
                        <TextBlock Text="Render Delay (ms):" Foreground="White" Margin="0,0,0,5"/>
                        <TextBox x:Name="RenderDelayTextBox" Width="100" HorizontalAlignment="Left" Background="#1e1e1e" Foreground="White" BorderBrush="#3e3e42"/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="UI">
                    <StackPanel Margin="10">
                        <CheckBox x:Name="ShowGridLinesCheckBox" Content="Show grid lines in Tracker view" Foreground="White"/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="About">
                    <StackPanel Margin="10">
                        <TextBlock Text="About MidiMaster" FontWeight="Bold" FontSize="16" Foreground="White" Margin="0,0,0,10"/>
                        <TextBlock Text="Version 0.1" Foreground="White" Margin="0,0,0,5"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#FF9999" FontWeight="Bold" Margin="0,0,0,15">
                            MidiMaster is and always will be 100% free software. If you have purchased this software, you have been scammed and the vendor has committed a crime.
                        </TextBlock>
                        <TextBlock Text="Legal Disclaimer:" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#cccccc" FontSize="11" LineHeight="16">
                            <Run FontWeight="Bold">MidiMaster</Run> is a specialized MIDI editor designed for Space Station 14.
                            By using this software, you retain full and exclusive ownership of any and all intellectual property rights, title, and interest in and to the musical compositions, MIDI files, and other materials (collectively, "User Content") created, generated, or modified through your use of MidiMaster. The creators, contributors, and distributors of this software claim no ownership, license, or rights whatsoever over your User Content.
                        </TextBlock>
                        <TextBlock Foreground="White" Margin="0,15,0,0">
                            <Run Text="Support development: "/>
                            <Hyperlink NavigateUri="https://ko-fi.com/tyrafox" RequestNavigate="Hyperlink_RequestNavigate">
                                <Run Text="https://ko-fi.com/tyrafox"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </TabItem>
            </TabControl>
            <!-- Footer -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,10,0,0">
                <Button Content="Save &amp; Close" Width="100" Height="30" Background="#007acc" Foreground="White" BorderBrush="Transparent" Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
