<Window x:Class="SS14_MIDI_IDE.UI.Windows.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MessageBox" Height="200" Width="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    
    <Border Background="#1e1e1e" BorderBrush="#333333" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/> <!-- Title bar -->
                <RowDefinition Height="*"/>  <!-- Message -->
                <RowDefinition Height="50"/> <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Background="#2d2d30" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock x:Name="TitleText" Grid.Column="0" Text="Message" Foreground="White" 
                           VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="SemiBold"/>
                
                <Button Grid.Column="1" Content="✕" Style="{StaticResource DialogCloseButtonStyle}" Click="CloseButton_Click"/>
            </Grid>

            <!-- Message Area -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20">
                <TextBlock x:Name="MessageText" Foreground="#d4d4d4" TextWrapping="Wrap" 
                           VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" TextAlignment="Center"/>
            </ScrollViewer>

            <!-- Button Area -->
            <StackPanel x:Name="ButtonPanel" Grid.Row="2" Orientation="Horizontal" 
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                
                <StackPanel.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Width" Value="80"/>
                        <Setter Property="Height" Value="28"/>
                        <Setter Property="Margin" Value="10,0"/>
                        <Setter Property="Background" Value="#333337"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="BorderBrush" Value="#4d4d50"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3f3f46"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#007acc"/>
                                <Setter Property="BorderBrush" Value="#007acc"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Resources>

                <!-- Buttons are injected dynamically via C# -->
            </StackPanel>
        </Grid>
    </Border>
</Window>
