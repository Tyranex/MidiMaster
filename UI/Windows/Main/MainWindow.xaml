<Window x:Class="SS14_MIDI_IDE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SS14_MIDI_IDE"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        mc:Ignorable="d"
        Title="MidiMaster" Height="450" Width="800"
        Icon="pack://application:,,,/mothroach.ico"
        WindowStyle="None"
        Background="#1e1e1e"
        UseLayoutRounding="True"
        StateChanged="MainWindow_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp"
        PreviewMouseMove="Window_PreviewMouseMove" PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="28" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Flat Toggle Button -->
        <Style x:Key="SimpleFlatToggleButton" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#44ffffff"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Flat Button -->
        <Style x:Key="SimpleFlatButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#44ffffff"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#66ffffff"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Flat ComboBox -->
        <Style x:Key="SimpleFlatComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Grid.Column="2" Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="15"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="1" Background="Transparent">
                                                    <Path x:Name="Arrow" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ToggleButton.Background>
                                    <TemplateBinding Property="Background"/>
                                </ToggleButton.Background>
                                <ToggleButton.BorderBrush>
                                    <TemplateBinding Property="BorderBrush"/>
                                </ToggleButton.BorderBrush>
                                <ToggleButton.BorderThickness>
                                    <TemplateBinding Property="BorderThickness"/>
                                </ToggleButton.BorderThickness>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="5,3,20,3" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid x:Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#2d2d30" BorderThickness="1" BorderBrush="#555555"/>
                                    <ScrollViewer Margin="1" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Context Menu Style -->
        <Style x:Key="DarkContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="BorderBrush" Value="#3e3e42"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="ItemContainerStyle" Value="{DynamicResource DarkContextMenuItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#252526"
                                BorderBrush="#3e3e42"
                                BorderThickness="1"
                                Padding="2">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
<Style TargetType="ContextMenu" BasedOn="{StaticResource DarkContextMenuStyle}"/>

        <!-- Top Level Menu Header Style -->
        <ControlTemplate x:Key="TopLevelHeaderTemplate" TargetType="MenuItem">
            <Grid x:Name="RootGrid">
                <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="8,4,8,4">
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                </Border>
                <Popup x:Name="SubMenuPopup" AllowsTransparency="True" Placement="Bottom" VerticalOffset="1" HorizontalOffset="0"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False"
                       PopupAnimation="Fade">
                    <Border Background="#252526" BorderBrush="#3e3e42" BorderThickness="1" Padding="2">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="#3e3e42"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="#3e3e42"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Submenu Item Template -->
        <ControlTemplate x:Key="SubmenuItemTemplate" TargetType="MenuItem">
            <Grid x:Name="RootGrid">
                <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="10,5,10,5">
                    <DockPanel LastChildFill="True">
                        <!-- Checkmark for checkable items -->
                        <Path x:Name="CheckMark" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0" Fill="#007acc" Data="M 0,3 L 3,6 L 8,0 L 7,0 L 3,4 L 1,2 Z" Visibility="Collapsed"/>
                        <!-- Arrow for submenus -->
                        <Path x:Name="SubMenuArrow" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="15,0,0,0" Fill="#aaaaaa" Data="M 0,0 L 4,3.5 L 0,7 Z" Visibility="Collapsed"/>
                        <!-- Input gesture text (Ctrl+Z, etc) -->
                        <TextBlock x:Name="GestureBlock" DockPanel.Dock="Right" Text="{TemplateBinding InputGestureText}" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="#888888" Visibility="Collapsed"/>
                        <!-- Header text -->
                        <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <!-- Popup for nested child submenus -->
                <Popup x:Name="SubMenuPopup" AllowsTransparency="True" Placement="Right" VerticalOffset="-3" HorizontalOffset="1"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False"
                       PopupAnimation="Fade">
                    <Border Background="#252526" BorderBrush="#3e3e42" BorderThickness="1" Padding="2">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="HasItems" Value="True">
                    <Setter TargetName="SubMenuArrow" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="InputGestureText" Value="">
                    <Setter TargetName="GestureBlock" Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="#3e3e42"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Dark Context Menu Item Style -->
        <Style x:Key="DarkContextMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#d4d4d4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template" Value="{StaticResource SubmenuItemTemplate}"/>
        </Style>

        <!-- Default MenuItem Style -->
        <Style TargetType="MenuItem" BasedOn="{StaticResource DarkContextMenuItemStyle}">
            <Style.Triggers>
                <Trigger Property="Role" Value="TopLevelHeader">
                    <Setter Property="Template" Value="{StaticResource TopLevelHeaderTemplate}"/>
                    <Setter Property="Padding" Value="8,4,8,4"/>
                </Trigger>
                <Trigger Property="Role" Value="TopLevelItem">
                    <Setter Property="Template" Value="{StaticResource TopLevelHeaderTemplate}"/>
                    <Setter Property="Padding" Value="8,4,8,4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Window Control Button Style -->
        <Style x:Key="WindowControlBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#aaaaaa"/>
            <Setter Property="Width" Value="45"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets, Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#3e3e42"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close Button Style (Red on hover) -->
        <Style x:Key="WindowCloseBtnStyle" TargetType="Button" BasedOn="{StaticResource WindowControlBtnStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#e81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
            <!-- Preferences Panels -->
        <Grid x:Key="GeneralPanel">
            <StackPanel Margin="10">
                <TextBlock Text="General Settings" FontSize="16" Foreground="White" Margin="0,0,0,10"/>
            </StackPanel>
        </Grid>
        <Grid x:Key="AudioPanel">
            <StackPanel Margin="10">
                <TextBlock Text="Audio Settings" FontSize="16" Foreground="White" Margin="0,0,0,10"/>
            </StackPanel>
        </Grid>
        <Grid x:Key="UiPanel">
            <StackPanel Margin="10">
                <TextBlock Text="UI Settings" FontSize="16" Foreground="White" Margin="0,0,0,10"/>
            </StackPanel>
        </Grid>
        <!-- Slide‑in/out animations -->
        
        </Window.Resources>
    <Grid Name="MainContentGrid" Background="#1e1e1e" MouseLeftButtonDown="MainContentGrid_MouseLeftButtonDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Custom Title Bar -->
            <RowDefinition Height="Auto"/> <!-- Menu -->
            <RowDefinition Height="Auto"/> <!-- Toolbar -->
            <RowDefinition Height="Auto"/> <!-- Reference Track Controls -->
            <RowDefinition Height="*"/>    <!-- Main Content -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>
        
        <Canvas x:Name="DragDropOverlayCanvas" Grid.RowSpan="6" Grid.ColumnSpan="10" Panel.ZIndex="999" IsHitTestVisible="False" />

        <!-- Custom Dark Title Bar -->
        <Grid Grid.Row="0" Background="#1e1e1e">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Title & App Icon -->
                <ColumnDefinition Width="*"/>    <!-- Drag Area -->
                <ColumnDefinition Width="Auto"/> <!-- Window Action Buttons -->
            </Grid.ColumnDefinitions>

            <!-- App Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <TextBlock Text="MidiMaster" Foreground="#cccccc" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Draggable Area -->
            <Border Grid.Column="1" Background="Transparent"/>

            <!-- Minimize, Maximize/Restore, Close -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource WindowControlBtnStyle}" Content="&#xE921;" ToolTip="Minimize" Click="WindowMinimize_Click"/>
                <Button x:Name="WindowMaximizeBtn" Style="{StaticResource WindowControlBtnStyle}" Content="&#xE922;" ToolTip="Maximize" Click="WindowMaximize_Click"/>
                <Button Style="{StaticResource WindowCloseBtnStyle}" Content="&#xE8BB;" ToolTip="Close" Click="WindowClose_Click"/>
            </StackPanel>
        </Grid>

        <!-- Menu Bar -->
        <Menu Grid.Row="1" Background="#2d2d30" Foreground="#d4d4d4" WindowChrome.IsHitTestVisibleInChrome="True">
            <MenuItem Header="File">
                <MenuItem Header="New Project" Click="FileNewProject_Click"/>
                <MenuItem Header="Open Project..." Click="FileOpenProject_Click"/>
                <MenuItem Header="Save Project" Click="FileSaveProject_Click"/>
                <MenuItem Header="Import MIDI..." Click="ImportMidi_Click"/>
                <MenuItem Header="Import FTM..." Click="FileImportFtm_Click"/>
                <Separator/>
                <MenuItem Header="Export as MIDI..." Click="ExportMidi_Click"/>
                <Separator/>
                <MenuItem Header="Exit" Click="WindowClose_Click"/>
                            
                </MenuItem>
            <MenuItem Header="Edit">
                <MenuItem x:Name="EditUndoMenu" Header="Undo" InputGestureText="Ctrl+Z" Click="EditUndo_Click"/>
                <MenuItem x:Name="EditRedoMenu" Header="Redo" InputGestureText="Ctrl+Y" Click="EditRedo_Click"/>
                <MenuItem x:Name="EditUndoHistoryMenu" Header="Undo History..." InputGestureText="Ctrl+H" Click="EditUndoHistory_Click"/>
                <Separator/>
                <MenuItem Header="Preferences" Click="PreferencesMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="Cut" InputGestureText="Ctrl+X" Click="EditCut_Click"/>
                <MenuItem Header="Copy" InputGestureText="Ctrl+C" Click="EditCopy_Click"/>
                <MenuItem Header="Paste" InputGestureText="Ctrl+V" Click="EditPaste_Click"/>
                <Separator/>
                <MenuItem Header="Delete" InputGestureText="Del" Click="EditDelete_Click"/>
            </MenuItem>
            <MenuItem Header="View">
                <MenuItem Header="Piano Roll" IsCheckable="True" IsChecked="False" x:Name="ViewPianoRollMenu" Click="ViewMode_Click"/>
                <MenuItem Header="Tracker" IsCheckable="True" IsChecked="True" x:Name="ViewTrackerMenu" Click="ViewMode_Click"/>
            </MenuItem>
            <MenuItem Header="Tools">
                <MenuItem Header="Maximize Volume" Click="MaximizeVolume_Click"/>
                <MenuItem Header="BPM Calculator" Click="BpmCalculator_Click"/>
                <MenuItem Header="Instrument Editor..." Click="InstrumentEditor_Click"/>
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="Check for Updates..." Click="CheckForUpdates_Click"/>
                <MenuItem Header="Changelog" Click="Changelog_Click"/>
            </MenuItem>
        </Menu>

        <!-- Tool Bar -->
        <ToolBarTray Grid.Row="2" Background="#2d2d30" WindowChrome.IsHitTestVisibleInChrome="True">
            <ToolBar Background="#2d2d30" Foreground="#d4d4d4">
                <Button x:Name="PlayButton" Content="Play" Click="PlayButton_Click" Foreground="#d4d4d4" Background="#3e3e42" Margin="2,0"/>
                <Button x:Name="StopButton" Content="Stop" Click="StopButton_Click" Foreground="#d4d4d4" Background="#3e3e42" Margin="2,0"/>
                <Separator />
                <Label Content="Tempo:" Foreground="#d4d4d4"/>
                <TextBox x:Name="TempoTextBox" Text="120" Width="40" Background="#1e1e1e" Foreground="#d4d4d4" BorderBrush="#3e3e42"/>
                <Separator />
                <ToggleButton x:Name="MetronomeButton" Content="Metronome: OFF" Click="MetronomeButton_Click" Foreground="#d4d4d4" Background="#3e3e42" Margin="2,0"/>
            </ToolBar>
        </ToolBarTray>

        <!-- Reference Track Controls -->
        <Border Grid.Row="3" Background="#252526" BorderBrush="#3e3e42" BorderThickness="0,0,0,1" Padding="5,3">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="LoadReferenceBtn" Content="Load Reference Audio" Click="LoadReference_Click" Foreground="#d4d4d4" Background="#3e3e42" Padding="5,2" Margin="5,0"/>
                <Label Content="Mix:" Foreground="#d4d4d4" VerticalAlignment="Center" Margin="15,0,5,0"/>
                <Slider x:Name="ReferenceMixSlider" Minimum="0" Maximum="1" Value="0" Width="100" VerticalAlignment="Center" ValueChanged="ReferenceMixSlider_ValueChanged" IsMoveToPointEnabled="True" AutoToolTipPlacement="TopLeft" AutoToolTipPrecision="2"/>
                <Label Content="Offset (ms):" Foreground="#d4d4d4" VerticalAlignment="Center" Margin="15,0,5,0"/>
                <TextBox x:Name="ReferenceOffsetTextBox" Text="0" Width="60" Background="#1e1e1e" Foreground="#d4d4d4" BorderBrush="#3e3e42" VerticalContentAlignment="Center" TextChanged="ReferenceOffsetTextBox_TextChanged"/>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/> <!-- Track Sidebar -->
                <ColumnDefinition Width="5"/>   <!-- Splitter -->
                <ColumnDefinition Width="*"/>   <!-- Piano Roll / Tracker -->
            </Grid.ColumnDefinitions>

            <!-- Track Sidebar -->
            <Border Grid.Column="0" Background="#252526" BorderBrush="#3e3e42" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Label DockPanel.Dock="Top" Content="Tracks" Foreground="#d4d4d4" FontWeight="Bold" Margin="5"/>
                    <Menu DockPanel.Dock="Top" Background="Transparent" Margin="5,0,5,5" BorderThickness="0">
                        <MenuItem Header="+ Add Track" x:Name="AddTrackMenuItem" Background="#3e3e42" Foreground="#d4d4d4" Padding="10,5">
                            <!-- Items populated dynamically in C# -->
                        </MenuItem>
                    </Menu>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TrackListPanel" Margin="0,10,0,0"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#3e3e42"/>

            <!-- Piano Roll Area -->
            <Border x:Name="PianoRollView" Grid.Column="2" Background="#1e1e1e" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/> <!-- Horizontal Waveform -->
                        <RowDefinition Height="30"/> <!-- Timeline Header -->
                        <RowDefinition Height="*"/>  <!-- Grid and Keys -->
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/> <!-- Piano Keys -->
                        <ColumnDefinition Width="*"/>  <!-- Grid -->
                    </Grid.ColumnDefinitions>

                    <!-- Top Left Corner -->
                    <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Background="#111111" BorderBrush="#3e3e42" BorderThickness="0,0,1,1"/>

                    <!-- Waveform Header -->
                    <ScrollViewer x:Name="HorizontalWaveformScrollViewer" Grid.Row="0" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <Canvas x:Name="HorizontalWaveformCanvas" Height="40" Background="#1a1a1c" MouseLeftButtonDown="WaveformCanvas_MouseLeftButtonDown" MouseMove="WaveformCanvas_MouseMove" MouseLeftButtonUp="WaveformCanvas_MouseLeftButtonUp"/>
                    </ScrollViewer>

                    <!-- Timeline Header -->
                    <ScrollViewer x:Name="TimelineScrollViewer" Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <Canvas x:Name="TimelineCanvas" Height="30" Background="#2d2d30" MouseLeftButtonDown="TimelineCanvas_MouseLeftButtonDown"/>
                    </ScrollViewer>

                    <ScrollViewer x:Name="KeysScrollViewer" Grid.Row="2" Grid.Column="0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <Canvas x:Name="KeysCanvas" Width="60" Height="2560" Background="#111111" />
                    </ScrollViewer>

                    <ScrollViewer x:Name="GridScrollViewer" Grid.Row="2" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ScrollChanged="GridScrollViewer_ScrollChanged" PreviewMouseWheel="GridScrollViewer_PreviewMouseWheel">
                        <Grid Name="PianoRollGrid" MouseLeftButtonDown="PianoRollGrid_MouseLeftButtonDown" Width="Auto" Height="2560">
                            <Canvas x:Name="BackgroundCanvas" Background="#1e1e1e" />
                            <Canvas x:Name="NoteCanvas" Background="Transparent" 
                                    MouseLeftButtonDown="NoteCanvas_MouseLeftButtonDown"
                                    MouseRightButtonDown="NoteCanvas_MouseRightButtonDown"
                                    MouseMove="NoteCanvas_MouseMove"
                                    MouseLeftButtonUp="NoteCanvas_MouseLeftButtonUp" />
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Rectangle x:Name="TrackerDimOverlay" Grid.Column="2" Fill="#88000000" Visibility="Collapsed" Panel.ZIndex="998" IsHitTestVisible="True"/>

            <!-- Tracker Area -->
            <Border x:Name="TrackerView" Grid.Column="2" Background="#1e1e1e" Visibility="Visible">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="45"/> <!-- Tracker Header (Columns) -->
                        <RowDefinition Height="*"/>  <!-- Tracker Grid -->
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>  <!-- Tracker Grid -->
                        <ColumnDefinition Width="60"/> <!-- Vertical Waveform -->
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="1" Background="#2d2d30" BorderBrush="#3e3e42" BorderThickness="1,0,0,1">
                        <TextBlock Text="Ref" Foreground="#d4d4d4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ScrollViewer x:Name="VerticalWaveformScrollViewer" Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
                        <Canvas x:Name="VerticalWaveformCanvas" Width="60" Background="#1a1a1c" MouseLeftButtonDown="WaveformCanvas_MouseLeftButtonDown" MouseMove="WaveformCanvas_MouseMove" MouseLeftButtonUp="WaveformCanvas_MouseLeftButtonUp"/>
                    </ScrollViewer>

                    <ScrollViewer x:Name="TrackerHeaderScrollViewer" Grid.Row="0" Grid.Column="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <Canvas x:Name="TrackerHeaderCanvas" Height="45" Background="#2d2d30" HorizontalAlignment="Left"/>
                    </ScrollViewer>
                    
                    <ScrollViewer x:Name="TrackerGridScrollViewer" Grid.Row="1" Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden" ScrollChanged="TrackerScrollViewer_ScrollChanged" UseLayoutRounding="False">
                        <Grid MinWidth="{Binding ViewportWidth, ElementName=TrackerGridScrollViewer}" Height="Auto" HorizontalAlignment="Left">
                            <Canvas x:Name="TrackerBackgroundCanvas" Background="#1e1e1e" Panel.ZIndex="0" HorizontalAlignment="Left" />
                            
                            <!-- Dark overlays for out-of-scope measures -->
                            <Rectangle x:Name="TrackerDarkOverlayTop" Fill="#88000000" HorizontalAlignment="Stretch" VerticalAlignment="Top" IsHitTestVisible="False" Height="0" Panel.ZIndex="4"/>
                            <Rectangle x:Name="TrackerDarkOverlayBottom" Fill="#88000000" HorizontalAlignment="Stretch" VerticalAlignment="Top" IsHitTestVisible="False" Height="0" Panel.ZIndex="4"/>
                            
                            <Canvas x:Name="TrackerContentCanvas" Background="Transparent" PreviewMouseLeftButtonDown="TrackerGrid_MouseLeftButtonDown" PreviewMouseMove="TrackerGrid_MouseMove" PreviewMouseLeftButtonUp="TrackerGrid_MouseLeftButtonUp" MouseRightButtonDown="TrackerGrid_MouseRightButtonDown" Panel.ZIndex="10" HorizontalAlignment="Left" />
                            
                            <Canvas x:Name="TrackerCursorCanvas" Background="Transparent" IsHitTestVisible="False" Panel.ZIndex="11" HorizontalAlignment="Left">
                                <Rectangle x:Name="TrackerActiveColumnHighlight" Fill="#11ffffff" Height="{Binding ActualHeight, ElementName=TrackerContentCanvas}" Width="110" IsHitTestVisible="False" Visibility="Collapsed" Canvas.ZIndex="1"/>
                                
                                <!-- Playhead for tracker -->
                                <Rectangle x:Name="TrackerPlayhead" Fill="#22ffffff" Height="20" Width="{Binding ActualWidth, ElementName=TrackerContentCanvas}" IsHitTestVisible="False" Canvas.ZIndex="2"/>
                                <Rectangle x:Name="TrackerSelectionHighlight" Fill="#33007ACC" Width="110" IsHitTestVisible="False" Visibility="Collapsed" Canvas.ZIndex="2"/>
                                <Rectangle x:Name="TrackerCursor" Fill="#55007ACC" Height="20" Width="32" IsHitTestVisible="False" Visibility="Collapsed" Canvas.ZIndex="5"/>
                            </Canvas>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        

            <!-- Dancing Mothroach Container -->
            <Grid Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20" Width="80" Height="80" 
                  Background="Transparent" MouseLeftButtonDown="Mothroach_MouseLeftButtonDown" Cursor="Hand">
                <Image x:Name="MothroachImage" 
                       Width="80" Height="80" 
                       IsHitTestVisible="False"
                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="MothroachTransform" ScaleX="1" ScaleY="1"/>
                    </Image.RenderTransform>
                </Image>
                <Canvas x:Name="HeartCanvas" IsHitTestVisible="False" Width="80" Height="80" ClipToBounds="False"/>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="5" Background="#2d2836" Foreground="White">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="White"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="ScrollLockStatusText" Text="SCRL" Foreground="#88ffffff" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Visible"/>
                    <Button x:Name="TimeSignatureButton" Content="4/4" Click="TimeSignatureButton_Click"
                        Background="Transparent" Foreground="White" BorderBrush="Transparent"
                        Padding="6,2" Cursor="Hand" FontWeight="SemiBold">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#1f8cd6"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#005999"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
